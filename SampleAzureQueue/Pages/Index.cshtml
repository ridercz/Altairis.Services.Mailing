@page
@model SampleAzureQueue.Pages.IndexModel
@{
}
<!DOCTYPE html>
<html>
<head>
    <title>Azure Queue Mail Demo</title>
    <style>
        :root {
            color-scheme: light;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            background: linear-gradient(180deg, #eef4ff 0%, #f8fafc 100%);
            color: #1e293b;
        }

        .page {
            width: min(100%, 42rem);
            background: #ffffff;
            border-radius: 1rem;
            box-shadow: 0 1.5rem 3rem rgba(15, 23, 42, 0.12);
            padding: 2rem;
        }

        h1 {
            margin: 0 0 0.5rem;
            font-size: 2rem;
        }

        .intro {
            margin: 0 0 1.5rem;
            color: #475569;
        }

        .alert-success {
            margin-bottom: 1.5rem;
            padding: 0.875rem 1rem;
            border-radius: 0.75rem;
            background: #dcfce7;
            color: #166534;
            border: 1px solid #86efac;
        }

        form {
            display: grid;
            gap: 1rem;
        }

        .field {
            display: grid;
            gap: 0.4rem;
        }

        label {
            font-weight: 600;
        }

        input,
        textarea {
            width: 100%;
            box-sizing: border-box;
            padding: 0.8rem 0.9rem;
            border: 1px solid #cbd5e1;
            border-radius: 0.75rem;
            font: inherit;
            background: #fff;
            color: inherit;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        input:focus,
        textarea:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.15);
        }

        textarea {
            resize: vertical;
            min-height: 10rem;
        }

        .field-validation-error {
            color: #b91c1c;
            font-size: 0.9rem;
        }

        button {
            justify-self: start;
            border: 0;
            border-radius: 10px;
            padding: 0.85rem 1.4rem;
            font: inherit;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            cursor: pointer;
            box-shadow: 0 0.75rem 1.5rem rgba(37, 99, 235, 0.25);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        button:hover {
            transform: translateY(-1px);
            box-shadow: 0 1rem 2rem rgba(37, 99, 235, 0.3);
        }

        button:active {
            transform: translateY(0);
        }
    </style>
</head>
<body>
    <main class="page">
        <h1>Azure Queue Mail Demo</h1>
        <p class="intro">Send a test email message through the Azure Queue mail service.</p>

        @if (Model.MessageSent) {
            <p class="alert-success">Message was sent.</p>
        }

        <form method="post">
            <div class="field">
                <label for="Recipient">Recipient</label>
                <input type="email" id="Recipient" asp-for="Recipient" required />
                <span asp-validation-for="Recipient"></span>
            </div>
            <div class="field">
                <label for="Subject">Subject</label>
                <input type="text" id="Subject" asp-for="Subject" required />
                <span asp-validation-for="Subject"></span>
            </div>
            <div class="field">
                <label for="Body">Body</label>
                <textarea id="Body" asp-for="Body" rows="6" required></textarea>
                <span asp-validation-for="Body"></span>
            </div>
            <div>
                <button type="submit">Send message</button>
            </div>
        </form>
    </main>
</body>
</html>
